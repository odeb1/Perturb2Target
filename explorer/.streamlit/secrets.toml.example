# Copy this file to `.streamlit/secrets.toml` and fill in your key.
# `secrets.toml` itself is gitignored — never commit a real key.
#
# On Streamlit Community Cloud do NOT use this file: paste the same line into
# the app's Settings -> Secrets panel instead.

ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: pin a specific model. Leave this out unless you need it — the app
# auto-selects a model that your key actually supports, which avoids breakage
# when a model id is retired. A stale pin here causes a 404.
# ANTHROPIC_MODEL = "claude-haiku-4-5-20251001"
